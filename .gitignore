# Universal gitignore - shared with all contributors
# Local-only patterns belong in .git/info/exclude (never tracked)

__pycache__/
*.py[cod]
*.so
.venv/
venv/
env/
ENV/
node_modules/
dist/
build/
*.egg-info/
.pytest_cache/
.mypy_cache/
.coverage
htmlcov/
.tox/
.DS_Store
Thumbs.db
*.db
*.db-shm
*.db-wal
*.sqlite-shm
*.sqlite-wal
*.log
.env
.env.*

# Backup payloads: large, regenerable, and may contain market data.
# The manifest under backups/ stays tracked as the audit record.
backups/**/*.csv

# Point-in-time archive raw payloads: lossless market data, not source.
# The manifest rows in myra_archive.db stay auditable.
archive/
backups/**/raw/
