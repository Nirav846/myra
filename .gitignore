# Universal gitignore - shared with all contributors
# Local-only patterns belong in .git/info/exclude (never tracked)

__pycache__/
*.py[cod]
*.so
.venv/
venv/
env/
ENV/
node_modules/
dist/
build/
*.egg-info/
.pytest_cache/
.mypy_cache/
.coverage
htmlcov/
.tox/
.DS_Store
Thumbs.db
*.log
.env
.env.*
